                        used_for display_browse (7)
                        links_to job_header.daf_case_manager;

            field job_species
                        used_for display_browse (8)
                        links_to job_header.daf_species;

           field job_breed
                        links_to job_header.daf_breed;
          
           field job_submitter_reference
                        links_to job_header.daf_submitter_reference;

           field job_submission_number
                        links_to job_header.daf_submission_number;

           field job_diagnosis_outcome
                        links_to job_header.daf_diagnosis_outcome;

           field job_case_reference
                        links_to job_header.daf_case_reference;

           field job_samples_to_do
                        links_to job_header.samples_to_do;

           field job_samples_received
                        links_to job_header.daf_samples_received;

            field job_project_id
                        used_for display_browse(14)
                        links_to job_header.daf_project_id;

            field job_is_legal_case
                        links_to job_header.daf_is_legal_case;

            field job_auto_disposed
                        links_to job_header.daf_auto_disposed;



            field testarea
                        used_for unique_key, display_browse (9)
                        links_to versioned_analysis.daf_testing_location;

            field daf_areasample
                       datatype text
                       used_for display_browse (10);

            field daf_areaanalysis
                       datatype text
                       used_for display_browse (11);

            field daf_test_datecreated
                       datatype date
                       used_for display_browse (12);

            field daf_date_all_tests_authorised
                       datatype date
                       used_for display_browse (13);

select_clause
            SELECT
                        jh.job_name,
                        jh.job_status,
                        jh.date_created AS job_date_created,
                        jh.date_completed AS job_date_completed,
                        jh.date_received AS job_date_received,
                        jh.submitter_oper AS job_submitter_oper,
                        jh.date_authorised AS job_date_authorised,
                        jh.authoriser AS job_authoriser,
                        jh.daf_submitter AS job_submitter,
                        jh.daf_submitter_name AS job_submitter_name,
                        jh.daf_old_property AS job_old_property,
                        jh.daf_property AS job_property,
                        jh.daf_party AS job_party,
                        jh.daf_pic AS job_pic,
                        jh.daf_case_manager AS job_case_manager,
                        jh.daf_species AS job_species,
                        jh.daf_breed AS job_breed,
                        jh.daf_submitter_reference AS job_submitter_reference,
                        jh.daf_submission_number AS job_submission_number,
                        jh.daf_diagnosis_outcome AS job_diagnosis_outcome,
                        jh.daf_case_reference AS job_case_reference,
                        jh.samples_to_do AS job_samples_to_do,
                        jh.daf_samples_received AS job_samples_received,
                        jh.daf_project_id AS job_project_id,
                        jh.daf_is_legal_case AS job_is_legal_case,
                        jh.daf_auto_disposed AS job_auto_disposed,
                        va.daf_testing_location AS testarea,

                       (SELECT STUFF((
                                               SELECT ', ' + CAST(COUNT(DISTINCT s2.id_numeric) AS VARCHAR) + ' ' + s2.sample_type
                                               FROM sample s2
                                              JOIN test t2 ON t2.sample = s2.id_numeric
                                              JOIN versioned_analysis va2 ON va2.[identity] = t2.analysis AND va2.active ='T'
                                              WHERE s2.job_name = jh.job_name
                                              AND va2.daf_testing_location = va.daf_testing_location
                                              GROUP BY s2.sample_type
                                              FOR XML PATH(''), TYPE
                                           ).value('.', 'NVARCHAR(MAX)'), 1, 2, '')) AS daf_areasample,

                      (SELECT STUFF((
                                              SELECT ', ' + t3.analysis
                                              FROM test t3
                                              JOIN sample s3 ON s3.id_numeric = t3.sample
                                              JOIN versioned_analysis va3 ON va3.[identity] = t3.analysis AND va3.active ='T'
                                              WHERE s3.job_name = jh.job_name
                                              AND va3.daf_testing_location = va.daf_testing_location
                                             GROUP BY t3.analysis
                                             FOR XML PATH(''), TYPE
                                           ).value('.', 'NVARCHAR(MAX)'), 1, 2, '')) AS daf_areaanalysis,
                        (SELECT MIN(t4.daf_date_created)
                         FROM test t4
                         JOIN sample s4 ON s4.id_numeric = t4.sample
                         JOIN versioned_analysis va4 ON va4.[identity] = t4.analysis AND va4.active='T'
                         WHERE s4.job_name = jh.job_name
                        AND va4.daf_testing_location = va.daf_testing_location
                         ) AS daf_test_datecreated,

                       (SELECT 
                                    (SELECT MAX(
                                                        CASE
                                                               WHEN t5.date_authorised IS NULL THEN s5.date_authorised
                                                               ELSE t5.date_authorised
                                                       END)
                                     FROM test t5
                                    JOIN sample s5 ON s5.id_numeric = t5.sample
                                    JOIN versioned_analysis va5 ON va5.[identity] = t5.analysis AND va5.active='T'
                                    WHERE s5.job_name = jh.job_name
                                    AND va5.daf_testing_location = va.daf_testing_location
                       )
                       WHERE NOT EXISTS (
                                                      SELECT 1
                                                      FROM test t6
                                                     JOIN sample s6 ON s6.id_numeric = t6.sample
                                                     JOIN versioned_analysis va6 ON va6.[identity] = t6.analysis AND va6.active='T'
                                                     WHERE s6.job_name = jh.job_name
                                                     AND va6.daf_testing_location = va.daf_testing_location
                                                     AND t6.date_authorised IS NULL
                                                     AND t6.status <> 'X'
                                                     AND s6.date_authorised IS NULL
                                                     
                                                   )
                        ) AS daf_date_all_tests_authorised

            FROM job_header jh
            JOIN sample s ON s.job_name = jh.job_name
            JOIN test t ON t.sample = s.id_numeric 
            JOIN versioned_analysis va ON va.[identity] = t.analysis AND va.active ='T'

            GROUP BY
                        jh.job_name,
                        jh.job_status,
                        jh.date_created,
                        jh.date_completed,
                        jh.date_received,
                        jh.submitter_oper,
                        jh.date_authorised,
                        jh.authoriser,
                        jh.daf_submitter,
                        jh.daf_submitter_name,
                        jh.daf_old_property,
                        jh.daf_property,
                        jh.daf_party,
                        jh.daf_pic,
                        jh.daf_case_manager,
                        jh.daf_species,
                        jh.daf_breed,
                        jh.daf_submitter_reference,
                        jh.daf_submission_number,
                        jh.daf_diagnosis_outcome,
                        jh.daf_case_reference,
                        jh.samples_to_do,
                        jh.daf_samples_received,
                        jh.daf_project_id,
                        jh.daf_is_legal_case,
                        jh.daf_auto_disposed,
                        va.daf_testing_location;



table daf_label_line;

    field label_guid
        datatype guid
        used_for unique_key;

    field sample
        links_to sample.id_numeric;


{* MC daf_job_newresults_view*}

view daf_job_newresults_view on_table job_header,
                                sample,
                                test,
                                attachment;

    field job_name
        used_for unique_key, primary_browse
        links_to job_header.job_name;

    field job_status
        links_to job_header.job_status;

    field job_date_created
        links_to job_header.date_created;

    field job_submitter
        used_for display_browse (1)
        links_to job_header.daf_submitter;

    field job_submitter_name
        used_for display_browse (2)
        links_to job_header.daf_submitter_name;

    field job_old_property
        used_for display_browse (3)
        links_to job_header.daf_old_property;

    field job_property
        used_for display_browse (4)
        links_to job_header.daf_property;

    field job_party
        used_for display_browse (5)
        links_to job_header.daf_party;

    field job_pic
        used_for display_browse (6)
        links_to job_header.daf_pic;

    field job_case_manager
        used_for display_browse (7)
        links_to job_header.daf_case_manager;

    field job_species
        used_for display_browse (8)
        links_to job_header.daf_species;

    field job_breed
        links_to job_header.daf_breed;

    field job_submitter_reference
        links_to job_header.daf_submitter_reference;

    field job_submission_number
        links_to job_header.daf_submission_number;

    field job_samples_to_do
        links_to job_header.samples_to_do;

    field job_samples_received
        links_to job_header.daf_samples_received;

    field job_project_id
        links_to job_header.daf_project_id;

    field job_is_legal_case
        links_to job_header.daf_is_legal_case;

    field result_last_updated_on
        datatype date;

    field last_reported_on
        datatype date;

    field new_results_available
        datatype boolean;


select_clause

    WITH ResultDates AS
    (
        SELECT
            s.job_name,

            MAX(
                CASE
                    WHEN t.status = 'A' THEN t.date_authorised
                    WHEN t.status = 'C' THEN t.date_completed
                END
            ) AS result_last_updated_on

        FROM sample s

        JOIN test t
            ON t.sample = s.id_numeric

        WHERE t.status IN ('A', 'C')

        GROUP BY
            s.job_name
    ),

    LatestAttachments AS
    (
        SELECT
            a.table_name,
            a.record_key0,
            a.name,
            MAX(a.version) AS latest_version

        FROM attachment a

        WHERE a.table_name = 'JOB_HEADER'

        GROUP BY
            a.table_name,
            a.record_key0,
            a.name
    ),

    ReportDates AS
    (
        SELECT
            a.record_key0 AS job_name,
            MAX(a.created_date) AS last_reported_on

        FROM attachment a

        JOIN LatestAttachments la
            ON la.table_name = a.table_name
           AND la.record_key0 = a.record_key0
           AND la.name = a.name
           AND la.latest_version = a.version

        WHERE a.table_name = 'JOB_HEADER'
          AND a.category IN ('INTERIMRPT', 'FINALRPT')
          AND a.type = 'FILE'
          AND a.created_date IS NOT NULL

        GROUP BY
            a.record_key0
    )

    SELECT
        jh.job_name,
        jh.job_status,
        jh.date_created AS job_date_created,
        jh.daf_submitter AS job_submitter,
        jh.daf_submitter_name AS job_submitter_name,
        jh.daf_old_property AS job_old_property,
        jh.daf_property AS job_property,
        jh.daf_party AS job_party,
        jh.daf_pic AS job_pic,
        jh.daf_case_manager AS job_case_manager,
        jh.daf_species AS job_species,
        jh.daf_breed AS job_breed,
        jh.daf_submitter_reference AS job_submitter_reference,
        jh.daf_submission_number AS job_submission_number,
        jh.samples_to_do AS job_samples_to_do,
        jh.daf_samples_received AS job_samples_received,
        jh.daf_project_id AS job_project_id,
        jh.daf_is_legal_case AS job_is_legal_case,

        rd.result_last_updated_on,

        rp.last_reported_on,

        CASE
            WHEN rp.last_reported_on IS NULL
                THEN NULL

            WHEN rd.result_last_updated_on > rp.last_reported_on
                THEN 'T'

            ELSE 'F'
        END AS new_results_available

    FROM job_header jh

    LEFT JOIN ResultDates rd
        ON rd.job_name = jh.job_name

    LEFT JOIN ReportDates rp
        ON rp.job_name = jh.job_name;
{end MC}
