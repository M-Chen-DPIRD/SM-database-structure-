select_clause

	SELECT job_header . job_name,
	       job_header . daf_pic,
	       job_header . daf_property,
	       job_header . daf_submitter,
	       job_header . daf_submitter_name,
	       customer . company_name,
	       job_header . daf_contact_name,
	       ( SELECT daf_party . name
		         FROM daf_party
		         WHERE daf_party . party_id = job_header . daf_party ),
	       job_header . daf_party,
	       job_header . daf_species,
	       ( SELECT daf_species . name
		         FROM daf_species
		         WHERE daf_species . [identity] = job_header . daf_species ),
	       job_header . date_created,
	       job_header . daf_modified_on,
	       job_header . job_status,
	       ( SELECT phrase . phrase_text
		         FROM phrase
		         WHERE phrase . phrase_type = 'JOB_STAT'
			 AND   phrase  . phrase_id  = job_header . job_status ) ,
	       job_header . daf_breed,
	       ( SELECT daf_species_breed . breed
		         FROM daf_species_breed
		         WHERE daf_species_breed . [identity] = job_header . daf_breed ),
	       job_header . daf_property_type,
	       ( SELECT phrase . phrase_text
		         FROM phrase
		         WHERE phrase . phrase_type = 'D_PROP_TYP'
			 AND   phrase  . phrase_id  = job_header . daf_property_type ),
	       job_header . daf_enterprise,
	       ( SELECT daf_enterprise . name
		         FROM daf_enterprise
		         WHERE daf_enterprise . [identity] = job_header . daf_enterprise ),
	       job_header . date_authorised

	FROM job_header,
	     customer,
	     daf_functional_area,
	     project_info

	WHERE job_header . job_status <> ( 'U' ) AND
	      job_header . daf_submitter = customer . [identity] AND
	      job_header . daf_functional_area = daf_functional_area . functional_area AND
	      daf_functional_area . include_bip_search = 'T' AND
	      job_header . daf_project_id = project_info . project_id AND
	      project_info . daf_include_bip_search = 'T'

