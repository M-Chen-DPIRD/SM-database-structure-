              links_to result.order_number ;
        field result_text
              links_to result.text ;
        field calculated_result
              datatype text (274);
        field lims2maxlink
              datatype text (45);
        	

SELECT_CLAUSE

	SELECT
		job_header.job_name    ,
		sample.id_numeric      ,
		test.test_number       ,
		result.name            ,
		job_header.job_status  ,
		job_header.date_created,
		sample.id_text         ,
		sample.status          ,
		sample.daf_nils        ,
		sample.sample_name     ,
		sample.sample_type     ,
		sample.description     ,
		versioned_analysis.name,
		test.analysis          ,
		test.status            ,
		result.order_number    ,
		result.text            ,
		( CASE WHEN result.name in  ('Test Result',
					     'Ehrlichia canis qPCR result',
					     'Ehrlichia canis anti-canine IgG')
		  THEN result.text
		  WHEN result.name in ('Anaplasma sp.','Ehrlichia sp.')
		  THEN CONCAT(result.name COLLATE Latin1_General_CI_AS_WS,result.text)
		  ELSE 'ERROR' END ) as calculated_result ,
		CONCAT ( sample.daf_nils, job_header.job_name ) as lims2maxlink		

	FROM
		{oj TEST LEFT OUTER JOIN RESULT ON TEST.TEST_NUMBER = RESULT.TEST_NUMBER},   
		JOB_HEADER,   
		SAMPLE,   
		VERSIONED_ANALYSIS 
		
	WHERE
		( Job_header.job_name = sample.job_name )
		AND ( sample.id_numeric = test.sample )
		AND ( test.analysis = versioned_analysis.[identity] )
                AND ( test.analysis_version = versioned_analysis.analysis_version)
		AND ( ( job_header.daf_case_reference = 'E.canis testing' )
		AND ( test.analysis IN ( 'ECANIS_TQM', 'ECAN_IFA', 'SNAP_4DX_', 'PCR_ECANIS', 'ECAN_AB_E' ) ) );
		{ORDER BY job_header.job_name, sample.id_text;}
		{AND ( result.name IN ('Anaplasma sp.','Ehrlichia sp.','Test Result','Ehrlichia canis qPCR result') )}


