              datatype date;

	field daf_job_new_results_available
              datatype boolean;

select_clause

    WITH ResultDates AS
    (
        SELECT
            s.job_name,

            MAX(
                CASE
                    WHEN t.status = 'A' THEN t.date_authorised
                    WHEN t.status = 'C' THEN t.date_completed
                END
            ) AS daf_job_last_updated_on

        FROM sample s

        JOIN test t
            ON t.sample = s.id_numeric

        WHERE t.status IN ('A', 'C')

        GROUP BY
            s.job_name
    ),

    LatestAttachments AS
    (
        SELECT
            a.table_name,
            a.record_key0,
            a.name,
            MAX(a.version) AS latest_version

        FROM attachment a

        WHERE a.table_name = 'JOB_HEADER'

        GROUP BY
            a.table_name,
            a.record_key0,
            a.name
    ),

    ReportDates AS
    (
        SELECT
            a.record_key0 AS job_name,
            MAX(a.created_date) AS daf_job_last_reported_on

        FROM attachment a

        JOIN LatestAttachments la
            ON la.table_name = a.table_name
           AND la.record_key0 = a.record_key0
           AND la.name = a.name
           AND la.latest_version = a.version

        WHERE a.table_name = 'JOB_HEADER'
          AND a.category IN ('INTERIMRPT', 'FINALRPT')
          AND a.type = 'FILE'
          AND a.created_date IS NOT NULL

        GROUP BY
            a.record_key0
    )

    SELECT
        s.id_numeric,
        s.job_name,

        jh.job_status,
        jh.browse_description AS job_description,
        jh.date_created AS job_date_created,
        jh.date_completed AS job_date_completed,
        jh.date_received AS job_date_received,
        jh.date_to_start AS job_date_to_start,
        jh.submitter_oper AS job_submitter_oper,
        jh.samples_to_do AS job_samples_to_do,
        jh.group_id AS job_group_id,
        jh.template_id AS job_template_id,
        jh.sample_template AS job_sample_template,
        jh.date_authorised AS job_date_authorised,
        jh.authoriser AS job_authoriser,
        jh.authorisation_notes AS job_authorisation_notes,

        s.id_text,
        s.status,
        s.old_status AS sample_old_status,
        s.compared,
        s.on_spec,
        s.re_sampled,
        s.original_sample,
        s.link_number,
        s.login_date,
        s.login_by,
        s.sampled_date,
        s.recd_date,
        s.date_started,
        s.starter,
        s.dateresreq,
        s.date_completed,
        s.completer,
        s.dateresavail,
        s.date_authorised AS sample_date_authorised,
        s.authoriser,
        s.authorisation_notes,
        s.product,
        s.product_version,
        s.grade_code,
        s.tests_to_do,
        s.on_wks,
        s.project_id,
        s.batch_name,
        s.sampling_point,
        s.sample_type,
        s.sample_name,
        s.description,
        s.preparation,
        s.hazard,
        s.substance,
        s.priority,
        s.location_id,
        s.customer_id,
        s.invoice_number,
        s.test_schedule,
        s.template_id,
        s.comp_prod_name,
        s.comp_prod_ver,
        s.comp_prod_grade,
        s.standard,
        s.batch_id,

        t.test_number,
        t.analysis,
        t.status AS test_status,
        t.instrument,

        r.name AS component_name,
        r.result_type,
        r.status AS result_status,
        r.text AS result_text,
        r.value AS result_value,
        r.units,
        r.minimum,
        r.maximum,
        r.out_of_range,
        r.entered_on AS date_result_entered,
        r.entered_by AS result_entered_by,
        r.date_authorised AS date_result_authorised,
        r.authoriser AS result_authoriser,
        r.order_number,

        rd.daf_job_last_updated_on,

        rp.daf_job_last_reported_on,

        CASE
            WHEN rp.daf_job_last_reported_on IS NULL
                THEN NULL

            WHEN rd.daf_job_last_updated_on > rp.daf_job_last_reported_on
                THEN 'T'

            ELSE 'F'
        END AS daf_job_new_results_available

    FROM sample s

    JOIN job_header jh
        ON jh.job_name = s.job_name

    JOIN test t
        ON t.sample = s.id_numeric

    JOIN result r
        ON r.test_number = t.test_number

    LEFT JOIN ResultDates rd
        ON rd.job_name = s.job_name

    LEFT JOIN ReportDates rp
        ON rp.job_name = s.job_name;






