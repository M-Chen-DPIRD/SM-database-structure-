view daf_job_test_available on_table 
				     sample    ,
				     test      ,
				     analysis  ;
        field job_name
	      links_to sample . job_name
	      used_for unique_key, primary_browse ;

        field case_manager
	      links_to job_header . daf_case_manager
	      used_for unique_key, display_browse (3) ;
		
        field analysis
              links_to test . analysis
	      used_for unique_key, display_browse (2) ;

	field daf_testing_location
	      links_to location . identity
	      used_for unique_key, display_browse (1) ;

	field date_created
	      links_to sample . login_date;

	field total_tests
		datatype integer
		used_for display_browse( 4 );

select_clause

	SELECT j . job_name             ,
	       j . daf_case_manager     ,
	       va . [identity]            ,
	       va . daf_testing_location,
	       j . date_created         ,
	       COUNT ( t . test_number ) as total_tests

	FROM job_header j,
		sample s,
		test   t,
		versioned_analysis va

	WHERE j . job_name = s . job_name
	AND j . job_status IN ( 'U', 'V' , 'C', 'I' )
	AND s . id_numeric = t . sample
	AND t . analysis = va . [identity]
	AND t . analysis_version = va . analysis_version
	AND t . status IN ( 'V' , 'P', 'U' )

	GROUP BY
		j . job_name             ,
		j . daf_case_manager     ,
		j . date_created         ,
		va . daf_testing_location,
		va . [identity];


