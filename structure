                CLE . ANALYSIS ,
                CLE . ANALYSIS_VERSION ,
                CLE . COMP_LIST ,
                CLE . NAME ,
                CLE . ORDER_NUMBER ,
                CLE . DEFAULT_VALUE ,
                CLE . REPLICATE_COUNT,
                CLE . RESULT_ENTRY,
                CLE . CREATE_ALWAYS,
                CLE . SPIKE_VALUE,
                CLE . SURROGATE_MLP

        FROM
                VERSIONED_C_L_ENTRY CLE

        WHERE
                ANALYSIS_VERSION = ( SELECT MAX ( ANALYSIS_VERSION )
                                     FROM VERSIONED_ANALYSIS A2
                                     WHERE A2 . [IDENTITY] = CLE . ANALYSIS  AND
