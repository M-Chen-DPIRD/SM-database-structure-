	       c_job_header . daf_pic,
	       c_job_header . daf_property,
	       c_job_header . daf_submitter,
	       c_job_header . daf_submitter_name,
	       customer . company_name,
	       c_job_header . daf_contact_name,
	       ( SELECT daf_party . name
		         FROM daf_party
		         WHERE daf_party . party_id = c_job_header . daf_party ),
	       c_job_header . daf_party,
	       c_job_header . daf_species,
	       ( SELECT daf_species . name
		         FROM daf_species
		         WHERE daf_species . [identity] = c_job_header . daf_species ),
	       c_job_header . date_created,
	       c_job_header . daf_modified_on,
	       c_job_header . job_status,
	       ( SELECT phrase . phrase_text
		         FROM phrase
		         WHERE phrase . phrase_type = 'JOB_STAT'
			 AND   phrase  . phrase_id  = c_job_header . job_status ) ,
	       c_job_header . daf_breed,
	       ( SELECT daf_species_breed . breed
		         FROM daf_species_breed
		         WHERE daf_species_breed . [identity] = c_job_header . daf_breed ),
	       c_job_header . daf_property_type,
	       ( SELECT phrase . phrase_text
		         FROM phrase
		         WHERE phrase . phrase_type = 'D_PROP_TYP'
			 AND   phrase  . phrase_id  = c_job_header . daf_property_type ),
	       c_job_header . daf_enterprise,
	       ( SELECT daf_enterprise . name
		         FROM daf_enterprise
		         WHERE daf_enterprise . [identity] = c_job_header . daf_enterprise ),
	       c_job_header . date_authorised

	FROM c_job_header,
	     customer,
	     daf_functional_area,
	     project_info

	WHERE c_job_header . job_status <> ( 'U' ) AND
