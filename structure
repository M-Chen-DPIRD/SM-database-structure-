   s . id_numeric            ,
   s . id_text               ,
   r . test_number           ,
   r . name                  ,
   r . text                  ,
   r . units                 ,
   r . entered_on            ,
   r . surrogate_mlp         ,
   r . surrogate_mlp_version
FROM
  batch_header h ,
  batch_entry  e ,
  test         t ,
  sample       s ,
  result       r
WHERE
  ( h . status      <> 'X'            ) AND
  ( e . [identity]  = h . [identity]  ) AND
  ( t . test_number = e . test        ) AND
  ( s . id_numeric  = t . sample      ) AND
  ( r . test_number = e . test        ) AND
  ( r . status IN ( 'A' , 'E' , 'M' ) ) ;


